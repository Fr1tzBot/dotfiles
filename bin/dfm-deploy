#!/usr/bin/env bash

TRIMMED_HOME=$(realpath -s "$HOME")
DOTFILES="$TRIMMED_HOME/Documents/dotfiles"
CONFIG="$TRIMMED_HOME/.config"

has() { type -p "$1" > /dev/null; }
#dfm_install: install a file from dotfiles
# args:
# 1. program - the name of the program to check for
# 2. destination - where to copy the file to
# 3. copydir - 1 to copy the directory, 0 to copy only its contents
# returns:
# 0 - success
# 73 - failed to create destination directory
# 74 - failed to copy file(s)
dfm_install() {
    if has "$1" ; then
        mkdir -p "$2" || return 73
        if (( $3 )) ; then
            cp -ruv "$DOTFILES/$1" "$2" || return 74
        else
            cp -ruv "$DOTFILES/$1/"* "$2" || return 74
        fi
    fi
    return 0
}
shopt -s dotglob

PROGS_HOME=("bash" "ssh" "git" "vim")
for prog in "${PROGS_HOME[@]}"; do
    dfm_install "$prog" "$TRIMMED_HOME" 0
done

PROGS_CONFIG=("foot" "kitty" "mpv" "fastfetch" "neofetch" "nvim" "noctalia" "rofi" "sway" "swaylock" "waybar" "niri" "dunst" "fuzzel" "cava")
for prog in "${PROGS_CONFIG[@]}"; do
    dfm_install "$prog" "$CONFIG" 1
done

cp -ruv "$DOTFILES/bin" "$TRIMMED_HOME/"

# nuke bashrc on termux to avoid double sourcing on startup
if [ -n "$TERMUX_VERSION" ] ; then
    rm -v "$TRIMMED_HOME/.bashrc"
fi
