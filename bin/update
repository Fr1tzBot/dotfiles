#!/usr/bin/env bash
# update: a script to automatically update software

# Check if specified program is in PATH
has() { type -p "$1" > /dev/null; }

contains() {
    local value="$1"
    shift
    local item
    for item in "$@"; do
        [ "$item" = "$value" ] && return 0
    done
    return 1
}

#TODO: Returns True if terminal supports color
SUPPORTS_COLOR=true

#Prints the specified string in green (if possible) prefixed with 'OK: '
ok() {
    if $SUPPORTS_COLOR ; then
        printf "\033[92mOK: %s\033[0m\n" "$1"
    else
        printf "OK: %s\n" "$1"
    fi
}

#Prints the specified string in yellow (if possible) prefixed with 'WARN: '
warn() {
    if $SUPPORTS_COLOR ; then
        printf "\033[93mWARN: %s\033[0m\n" "$1"
    else
        printf "WARN: %s\n" "$1"
    fi
}

#Prints the specified string in red (if possible) prefixed with 'ERROR: ' and exits with code 1
error() {
    if $SUPPORTS_COLOR ; then
        printf "\033[91mERROR: %s\033[0m\n" "$1"
    else
        printf "ERROR: %s\n" "$1"
    fi
    exit 1
}

ROOT_STRING=""
if [ -n "$TERMUX_VERSION" ] ; then
    ok "No Root Privileges on Termux"
elif [ $EUID -eq 0 ] ; then
    true
elif has doas ; then
    ROOT_STRING="doas"
elif has sudo ; then
    ROOT_STRING="sudo"
else
    error "no root privileges found.\nYou can try running this script as root or verifying that sudo or doas is in your PATH"
fi

ok "Using '$ROOT_STRING' as root prefix"

declare -A MANAGER_LIST
MANAGER_LIST["apt-get"]="$ROOT_STRING apt-get update &&
                         $ROOT_STRING apt-get upgrade &&
                         $ROOT_STRING apt-get autoremove"
MANAGER_LIST["brew"]="brew update &&
                      brew upgrade &&
                      brew autoremove"
MANAGER_LIST["dnf"]="$ROOT_STRING dnf upgrade"
MANAGER_LIST["dfm"]="dfm update &&
                     dfm upgrade"
MANAGER_LIST["emerge"]="$ROOT_STRING emerge --sync &&
                        $ROOT_STRING emerge --update --deep --with-bdeps=y @world &&
                        $ROOT_STRING emerge --deepclean"
MANAGER_LIST["flatpak"]="$ROOT_STRING flatpak update"
MANAGER_LIST["softwareupdate"]="softwareupdate --verbose -lir --agree-to-license"
MANAGER_LIST["nvim"]="nvim --headless -c \"lua if vim.pack then vim.pack.update() end\" -c qa && echo"
MANAGER_LIST["pacman"]="$ROOT_STRING pacman -Syu"
MANAGER_LIST["pkg"]="pkg upgrade &&
                     pkg autoclean"
MANAGER_LIST["port"]="port -v selfupdate &&
                      port -v upgrade outdated &&
                      port -v uninstall inactive"
MANAGER_LIST["scoop"]="scoop update"
MANAGER_LIST["snap"]="$ROOT_STRING snap refresh"
MANAGER_LIST["tldr"]="tldr -u"
MANAGER_LIST["yay"]="yay -Syu --noconfirm"

toUpdate=("${!MANAGER_LIST[@]}")
listMode=false
toSkip=()

while [ $# -gt 0 ] ; do
    case "$1" in
        -u|--update)
            shift
            toUpdate=()
            while [ $# -gt 0 ] && [ "${1:0:1}" != "-" ] ; do
                toUpdate+=("$1")
                shift
            done
            ;;
        -s|--skip)
            shift
            toSkip=()
            while [ $# -gt 0 ] && [ "${1:0:1}" != "-" ] ; do
                toSkip+=("$1")
                shift
            done
            ;;
        -l|--list)
            listMode=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if $listMode ; then
    printf "Managers: "
fi

for key in "${toUpdate[@]}" ; do
    if has "$key" && ! contains "$key" "${toSkip[@]}" ; then
        if $listMode ; then
            printf "%s, " "$key"
        else
            ok "Updating $key."
            eval "${MANAGER_LIST[$key]}"
        fi
    fi
done

if $listMode ; then
    printf "\b\b \n"
fi
