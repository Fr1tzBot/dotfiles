#!/usr/bin/env bash

has() { type -p "$1" > /dev/null; }

TRIMMED_HOME=$(realpath -s "$HOME")
DOTFILES="$TRIMMED_HOME/Documents/dotfiles"
ROOT_STRING=""

# technically this is a bad check cuz nix can be installed on non-nixos systems...
# TODO improve
! has nix && printf "nix not detected." && exit 1

if [ -n "$TERMUX_VERSION" ] ; then
    ok "No Root Privileges on Termux"
elif [ $EUID -eq 0 ] ; then
    true
elif has doas ; then
    ROOT_STRING="doas"
elif has sudo ; then
    ROOT_STRING="sudo"
else
    error "no root privileges found.\nYou can try running this script as root or verifying that sudo or doas is in your PATH" 126
fi

$ROOT_STRING cp -ruv "$DOTFILES/nixos" "/etc/"

read -rp "Would you like to rebuild now? [Y/n] " response
case "${response,,}" in
    no|n) exit 0
esac

$ROOT_STRING nixos-rebuild switch
exit 0

