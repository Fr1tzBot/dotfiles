             default: 0,
             description: "Opt-in J414s enrollment test: export owner from the fresh context, then save user before master at completion",
         },
+        key_store_v5: u8 {
+            default: 0,
+            description: "T8103: use the variant-5 key store (as T6020) instead of the 13.5 one; needed for a variant-5 identity keybag",
+        },
     },
 }
