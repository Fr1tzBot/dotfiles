+// mesa-vault linux8: reads macOS sends around every master save (run11). Request shapes from its buffers.
+const OP_SBIO_GET_CATACOMB_ID: u16 = 0x33;
+const OP_SBIO_GET_CATACOMB_HASH: u16 = 0x36;
+const OP_SBIO_GET_CATACOMB_GROUP_STATE: u16 = 0x79;
+pub(crate) fn sbio_get_catacomb_id(user: i32) -> SbioOp {
+    SbioOp {
+        opcode: OP_SBIO_GET_CATACOMB_ID,
+        payload: pad_payload(&user.to_le_bytes()),
+        payload_len: 4,
+        name: c"GET_CATACOMB_ID",
+    }
+}
+pub(crate) fn sbio_get_catacomb_hash(user: i32) -> SbioOp {
+    SbioOp {
+        opcode: OP_SBIO_GET_CATACOMB_HASH,
+        payload: pad_payload(&user.to_le_bytes()),
+        payload_len: 4,
+        name: c"GET_CATACOMB_HASH",
+    }
+}
+// mesa-vault linux11: requests macOS sends in enrolment that Aurora doesn't (run28 buffers: 0x28 and 0x39 carry no
+// payload; 0x54 carries the user id and the 16-byte identity UUID).
+pub(crate) fn sbio_macos_0x28() -> SbioOp {
+    SbioOp { opcode: 0x28, payload: pad_payload(&[]), payload_len: 0, name: c"MACOS_0x28" }
+}
+pub(crate) fn sbio_macos_0x39() -> SbioOp {
+    SbioOp { opcode: 0x39, payload: pad_payload(&[]), payload_len: 0, name: c"GET_SYSTEM_PROTECTED_CONFIG" }
+}
+pub(crate) fn sbio_macos_0x54(user: i32, uuid: &[u8; 16]) -> SbioOp {
+    let mut b = [0u8; 20];
+    b[..4].copy_from_slice(&user.to_le_bytes());
+    b[4..].copy_from_slice(uuid);
+    SbioOp { opcode: 0x54, payload: pad_payload(&b), payload_len: 20, name: c"GET_TOPOLOGY_OF_TEMPLATE" }
+}
+pub(crate) fn sbio_get_catacomb_group_state() -> SbioOp {
+    SbioOp {
+        opcode: OP_SBIO_GET_CATACOMB_GROUP_STATE,
+        payload: pad_payload(&[]),
+        payload_len: 0,
+        name: c"GET_CATACOMB_GROUP_STATE",
+    }
+}
