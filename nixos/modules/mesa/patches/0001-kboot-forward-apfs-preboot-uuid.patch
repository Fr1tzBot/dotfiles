diff --git a/src/kboot.c b/src/kboot.c
index 9bb95481..7421532a 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -310,6 +310,25 @@ static int dt_set_chosen(void)
                     strlen(os_firmware.string) + 1))
         bail("FDT: couldn't set asahi,os-fw-version\n");
 
+    /*
+     * Forward the OS identity iBoot handed to this boot entry. The SEP asks for it (xarm GET_OS_UUID) and
+     * refuses the system-scope Touch ID catacomb without it. An explicit chosen.apfs-preboot-uuid variable wins.
+     * (m1harness local patch; not sent upstream.)
+     */
+    if (is_mac && fdt_getprop(dt, node, "apfs-preboot-uuid", NULL) == NULL) {
+        int anode = adt_path_offset(adt, "/chosen");
+        u32 len = 0;
+        const char *uuid = anode >= 0 ? adt_getprop(adt, anode, "apfs-preboot-uuid", &len) : NULL;
+        if (uuid && len >= 36) {
+            char buf[40];
+            memcpy(buf, uuid, 36);
+            buf[36] = 0;
+            if (fdt_setprop_string(dt, node, "apfs-preboot-uuid", buf))
+                bail("FDT: couldn't set apfs-preboot-uuid\n");
+            printf("FDT: forwarded apfs-preboot-uuid\n");
+        }
+    }
+
     if (fdt_setprop(dt, node, "asahi,m1n1-stage2-version", m1n1_version, strlen(m1n1_version) + 1))
         bail("FDT: couldn't set asahi,m1n1-stage2-version\n");
 
